{
  "name": "field-shift-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "tools/*"
  ],
  "scripts": {
    "generate:tokens": "node scripts/build-tokens.mjs",
    "generate:api": "npm run generate --workspace=@field-shift/contract-types",
    "generate": "npm run generate:tokens && npm run generate:api",
    "predev": "npm run generate",
    "dev": "vite",
    "prebuild": "npm run generate",
    "build": "tsc -b && vite build",
    "prelint": "npm run generate",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "maplibre-gl": "^6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
